# VJM site — environment configuration template.
# NEVER put real secret values in this file or any committed file.
# Configure these in Cloudflare Dashboard → Workers & Pages → [project]
#   → Settings → Variables and Secrets (Production AND Preview).
# Copy names exactly; values below are placeholders only.

# ── Required: session signing ────────────────────────────────────────────
# Dedicated HMAC key for premium session cookies. >= 32 random chars.
# Generate e.g. with: openssl rand -base64 48
SESSION_SIGNING_SECRET=set-a-long-random-value-here

# ── Required: member bridge (choose ONE mode) ────────────────────────────
# Preferred: authenticated single-record Apps Script bridge.
MEMBERS_BRIDGE_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
MEMBERS_BRIDGE_SECRET=set-a-long-random-value-here

# Deprecated legacy full-map bridge URL. Remove after migration.
MEMBERS_STATUS_URL=https://script.google.com/macros/s/OLD_DEPLOYMENT_ID/exec

# Temporary escape hatch ONLY during key rotation: allows the old (unsafe)
# PREMIUM_ACCESS_CODES-as-HMAC-key tokens to verify. Delete after rollout.
LEGACY_ALLOW_CODES_AS_KEY=false

# ── Legacy (still read by research-engine authorize path) ───────────────
PREMIUM_ACCESS_CODES=CODE1,CODE2

# ── Market data (Alpaca) ─────────────────────────────────────────────────
ALPACA_API_KEY=your-key-id
ALPACA_SECRET_KEY=your-secret-key

# ── Optional persistence / rate limiting (D1 binding) ───────────────────
# Bind a D1 database in the Pages project as RATELIMIT_DB (and RESEARCH_DB
# for research snapshots). Apply migrations/0002_security_tables.sql.
RATELIMIT_DB=__d1-binding-name__
RESEARCH_DB=__d1-binding-name__

# ── Session lifetime ─────────────────────────────────────────────────────
SESSION_DAYS=7

# ── Scheduled refresh (GitHub Actions secret, not Cloudflare) ────────────
RESEARCH_REFRESH_URL=https://notfinancialadvicevjm.com
RESEARCH_CRON_SECRET=set-a-long-random-value-here

# ── Future integrations (not yet wired; see docs/DISCORD-INTEGRATION.md) ─
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_PREMIUM_ROLE_ID=
WHOP_WEBHOOK_SECRET=
