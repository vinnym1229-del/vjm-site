# VJM site — environment configuration template.
# NEVER put real secret values in this file or any committed file.
# Configure these in Cloudflare Dashboard → Workers & Pages → [project]
#   → Settings → Variables and Secrets (Production AND Preview).
# Copy names exactly; values below are placeholders only.

# ── Required: session signing ────────────────────────────────────────────
# Dedicated HMAC key for premium session cookies. >= 32 random chars.
# Generate e.g. with: openssl rand -base64 48
SESSION_SIGNING_SECRET=set-a-long-random-value-here

# ── Required: member bridge (choose ONE mode) ────────────────────────────
# Preferred: authenticated single-record Apps Script bridge.
MEMBERS_BRIDGE_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
MEMBERS_BRIDGE_SECRET=set-a-long-random-value-here

# Deprecated legacy full-map bridge URL. Remove after migration.
MEMBERS_STATUS_URL=https://script.google.com/macros/s/OLD_DEPLOYMENT_ID/exec

# Temporary escape hatch ONLY during key rotation: allows the old (unsafe)
# PREMIUM_ACCESS_CODES-as-HMAC-key tokens to verify. Delete after rollout.
LEGACY_ALLOW_CODES_AS_KEY=false

# ── Legacy (still read by research-engine authorize path) ───────────────
PREMIUM_ACCESS_CODES=CODE1,CODE2

# ── Market data (Alpaca) ─────────────────────────────────────────────────
ALPACA_API_KEY=your-key-id
ALPACA_SECRET_KEY=your-secret-key

# ── Optional persistence / rate limiting (D1 binding) ───────────────────
# Bind a D1 database in the Pages project as RATELIMIT_DB (and RESEARCH_DB
# for research snapshots). Apply migrations/0002_security_tables.sql.
RATELIMIT_DB=__d1-binding-name__
RESEARCH_DB=__d1-binding-name__

# ── Session lifetime ─────────────────────────────────────────────────────
SESSION_DAYS=7

# ── Entitlements: which Whop products map to which tier ──────────────────
# Until BOTH lists below are set, the site stays in its previous behaviour:
# every verified member is treated as Complete. That is deliberate, so that
# deploying the tier work does not lock out live members — but it also means
# the $100 and $129 products are still identical until you fill these in.
#
# Set them to the Whop product and/or plan IDs you actually sell. Comma or
# whitespace separated; an ID in NEITHER list grants nothing at all, which is
# what stops a cheaper or separately sold product becoming a full credential.
WHOP_PRODUCTS_FUTURES=prod_xxx_futures_only,plan_xxx_futures_monthly
WHOP_PRODUCTS_COMPLETE=prod_xxx_complete

# Tier used ONLY while the two lists above are both empty. Leave as complete
# unless you want unconfigured deployments to grant less.
#   one of: free | futures_core | complete
WHOP_DEFAULT_TIER=complete

# Sessions minted before tiers existed carry no tier claim. By default they
# are grandfathered as Complete until they expire on their own (SESSION_DAYS,
# 30 max), so nobody is signed out by the upgrade and the window closes by
# itself. Set to true to cut that short and force one re-authentication.
STRICT_LEGACY_SESSIONS=false

# ── Scheduled refresh (GitHub Actions secret, not Cloudflare) ────────────
RESEARCH_REFRESH_URL=https://notfinancialadvicevjm.com
RESEARCH_CRON_SECRET=set-a-long-random-value-here

# ── AI narrative engine: NO API KEY NEEDED ───────────────────────────────
# The assistant + market brief use the Cloudflare Workers `AI` binding
# (Workers AI free daily allocation — no Anthropic/OpenAI key, no per-token
# billing). Bind it in Cloudflare Dashboard → Pages project → Settings →
# Functions → AI bindings, name it exactly: AI

# ── Discord webhooks (optional; feature stays off when blank) ────────────
# Receives the auto pre-market brief each weekday morning.
DISCORD_ANNOUNCEMENTS_WEBHOOK=
# Owner-only channel that receives fresh Whop purchase codes for delivery.
DISCORD_WHOP_CODES_WEBHOOK=

# ── Owner content CMS (Google Sheets → site + Discord) ──────────────────
# Authenticated Apps Script bridge (see docs/APPS-SCRIPT-INTEGRATION.md).
CONTENT_BRIDGE_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
CONTENT_BRIDGE_SECRET=set-a-long-random-value-here
# "true" (default) logs announcements without posting to Discord.
# Set to "false" ONLY when new announcements should auto-post.
CONTENT_DISCORD_DRYRUN=true

# ── Pre-market brief tuning (optional) ──────────────────────────────────
# Comma list used when the Alpaca screener is unavailable (free feed).
BRIEF_UNIVERSE=SPY,QQQ,NVDA,AAPL,MSFT,TSLA,AMD,META,AMZN,GOOGL

# ── Whop entitlement webhook ──────────────────────────────────────────────
WHOP_WEBHOOK_SECRET=
