# Cloudflare Pages security headers.
# Applies to static assets. API routes set their own no-store + nosniff
# headers inside each Function (see functions/api/_lib/http.js).
# Inline script/style are still required by the current pages (documented
# debt in docs/SECURITY.md §CSP); no wildcard sources are used.

# ── INDEXING (default deny; the middleware lifts it per request) ──
# The `X-Robots-Tag: noindex` in the /* block below is now a DEFAULT, not a
# switch someone has to remember to flip. functions/_middleware.js removes it
# per request when — and only when — the request arrives on the canonical host
# declared in robots.txt and the path is not one of the permanent exclusions
# below (see functions/api/_lib/indexing.js).
#
# So: a *.pages.dev deployment or any preview host is never indexable, the real
# domain becomes indexable the moment it is actually serving the site, and a
# bug anywhere in that path fails toward "not indexed" rather than toward "the
# preview host is in Google", which is the far more expensive mistake.
#
# DO NOT delete the line below to "turn on indexing" — it is what makes the
# default safe. To hold the whole site back again, set the INDEXING environment
# variable to anything other than `on` in Cloudflare Pages.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Robots-Tag: noindex
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://s3.tradingview.com https://www.tradingview.com https://accounts.google.com https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.tradingview.com wss://*.tradingview.com https://*.alpaca.markets https://accounts.google.com https://challenges.cloudflare.com https://cloudflareinsights.com; frame-src https://www.tradingview.com https://s3.tradingview.com https://www.tradingview-widget.com https://s.tradingview.com https://accounts.google.com https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=300, must-revalidate

# ── PERMANENT noindex — survives lifting the switch above ──
# Member/app tools, the research engine, premium guidance, API and video
# routes, and the /pj/* static preview copies must never be indexed at any
# path they are served from. Listed in both the extensionless and .html forms
# because Cloudflare Pages serves and redirects both.
/pj/*
  X-Robots-Tag: noindex, nofollow

/api/*
  X-Robots-Tag: noindex, nofollow

/video/*
  X-Robots-Tag: noindex, nofollow

/stock-lab
  X-Robots-Tag: noindex, nofollow

/stock-lab.html
  X-Robots-Tag: noindex, nofollow

/research-engine
  X-Robots-Tag: noindex, nofollow

/research-engine.html
  X-Robots-Tag: noindex, nofollow

/premium-guidance
  X-Robots-Tag: noindex, nofollow

/premium-guidance.html
  X-Robots-Tag: noindex, nofollow

# The unsubscribe page must never be indexed. A search result for it is a way
# for a crawler — or anyone who is not the subscriber — to reach an opt-out
# flow, and there is nothing here worth ranking.
/unsubscribe
  X-Robots-Tag: noindex, nofollow

/unsubscribe.html
  X-Robots-Tag: noindex, nofollow
