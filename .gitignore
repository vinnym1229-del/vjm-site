# Real environment files must never be committed. .env.example is the
# template and is intentionally NOT ignored; every other .env variant is.
.env
.env.*
!.env.example

# Dependencies and build output
# No trailing slash: some sandboxes symlink node_modules to a shared cache
# instead of a real directory, and a slash-anchored pattern only matches a
# real directory, not a symlink -- leaving the symlink to show as untracked.
node_modules
.wrangler/
dist/
.DS_Store
coverage/

# Local tooling scratch
.opencode/

# Stray nested repo (NLM.pine working copy) — not part of this site
vjm-site/
